#pragma code_page(65001)
// Иконка и сведения о версии для Crumb.exe, crumb_helper.exe и crumb_setup.exe.
// IDI_ICON1 — это имя Qt использует как иконку окон по умолчанию.

IDI_ICON1 ICON "icons/build/crumb.ico"

1 VERSIONINFO
FILEVERSION 0,5,0,0
PRODUCTVERSION 0,5,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "Crumb"
      VALUE "FileDescription", "Crumb — браузер в стиле Material You"
      VALUE "ProductName", "Crumb"
      VALUE "FileVersion", "0.5.0"
      VALUE "ProductVersion", "0.5.0"
      VALUE "LegalCopyright", "Crumb"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
